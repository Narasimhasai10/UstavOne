{
  "name": "utsavora-backend",
  "version": "1.0.0",
  "description": "Utsavora – REST API and WebSocket server built with Express and Prisma",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "db:migrate": "npx --no-install prisma migrate dev --schema ../database/schema.prisma",
    "db:push": "npx --no-install prisma db push --schema ../database/schema.prisma",
    "db:deploy": "node ../scripts/db-deploy.mjs",
    "db:generate": "npx --no-install prisma generate --schema ../database/schema.prisma",
    "db:seed": "node ../database/seed.js",
    "db:seed:prod": "node ../scripts/db-seed-prod.mjs",
    "check:prisma": "node -e \"const {PrismaClient}=require('@prisma/client'); new PrismaClient(); console.log('client ok')\"",
    "test": "node tests/runner.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  }
}
