# ==========================================
# Utsavora Backend Environment Configuration
# ==========================================

# Server
PORT=4000
NODE_ENV=development

# Database Connection String
# Local SQLite:
DATABASE_URL="file:../database/utsavora.db"
# Remote Neon PostgreSQL:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.neon.tech/neondb?sslmode=require"

# Authentication Secrets (Must be 32+ characters in production)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET="utsavora-dev-jwt-super-secret-key-32chars-min"
REFRESH_SECRET="utsavora-dev-refresh-super-secret-key-32chars-min"

# Admin User Password (Change for production)
ADMIN_PASSWORD="Admin@12345"

# File Storage Provider: "local" or "cloudinary"
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="utsavora"
UPLOAD_DIR="./uploads"

# Security & CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,null"
ALLOW_FILE_ORIGIN="false"
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Business Rules
HOLD_MINUTES=10
COMMISSION_RATE=10
GST_PERCENT=18

# Payment Provider ("mock" or "razorpay")
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# AI Verification
GEMINI_API_KEY=""
