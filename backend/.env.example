# Server
PORT=4000
NODE_ENV=development

# Database (SQLite default or PostgreSQL URI)
# For SQLite: "file:../database/vedika.db"
# For PostgreSQL: "postgresql://username:password@localhost:5432/vedika?schema=public"
DATABASE_URL="file:../database/vedika.db"

# Security: Generate secure 32+ character random strings for production
# Example command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-32-char-string-in-production"
REFRESH_SECRET="replace-with-another-random-32-char-string-in-production"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,null"

# Uploads
UPLOAD_DIR="./uploads"

# Payment Adapter ("mock" or "razorpay")
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# AI Verification
GEMINI_API_KEY=""

# Business Rules
HOLD_MINUTES=15
COMMISSION_RATE=10
GST_PERCENT=18
