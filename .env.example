# Vedika Root Environment Example
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./database/vedika.db"

# Security
# Generate new random 32-char keys before deployment:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-32-char-string-in-production"
REFRESH_SECRET="replace-with-another-random-32-char-string-in-production"

CORS_ORIGINS="http://localhost:5173,http://localhost:4173,null"
VITE_API_URL="http://localhost:4000/api/v1"
PAYMENT_PROVIDER="mock"
