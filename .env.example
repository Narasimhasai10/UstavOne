# ==========================================
# Utsavora Application Configuration Template
# ==========================================

# Environment & Server
PORT=4000
NODE_ENV=development

# Database Configuration
# Local SQLite (default):
DATABASE_URL="file:./database/utsavora.db"
# Neon / Remote PostgreSQL (Production):
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.neon.tech/neondb?sslmode=require"

# JWT & Authentication (Production requires at least 32 characters)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET="utsavora-dev-jwt-super-secret-key-32chars-min"
REFRESH_SECRET="utsavora-dev-refresh-super-secret-key-32chars-min"

# Administrator Password (Required non-default in production)
ADMIN_PASSWORD="Admin@12345"

# Storage Provider: "local" (default for dev) or "cloudinary" (production)
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="utsavora"

# CORS Origins (comma-separated URLs)
CORS_ORIGINS="http://localhost:5173,http://localhost:4173,null"
ALLOW_FILE_ORIGIN="false"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=30
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Business Rules
HOLD_MINUTES=10
COMMISSION_RATE=10
GST_PERCENT=18

# Payment Adapter ("mock" or "razorpay")
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
