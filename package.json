{
  "name": "utsavora-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Utsavora – Full-stack event-booking marketplace (React + Vite, Node + Express + Prisma + SQLite)",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --prefix frontend && node scripts/build-singlefile.mjs",
    "build:standalone": "npm run build --prefix frontend && node scripts/build-singlefile.mjs",
    "start": "npm run start --prefix backend",
    "test": "npm test --prefix backend && npm test --prefix frontend",
    "check": "node scripts/check.mjs",
    "check:prisma": "node -e \"const {PrismaClient}=require('@prisma/client'); new PrismaClient(); console.log('client ok')\"",
    "export": "node scripts/export.mjs",
    "verify": "node scripts/verify-all.mjs",
    "verify:all": "node scripts/verify-all-e2e.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:generate": "npx --no-install prisma generate --schema database/schema.prisma",
    "db:use:sqlite": "node scripts/use-db.mjs sqlite",
    "db:use:postgres": "node scripts/use-db.mjs postgres",
    "db:deploy": "node scripts/db-deploy.mjs",
    "db:seed": "node database/seed.js",
    "db:seed:prod": "node scripts/db-seed-prod.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
